{
  "name": "electron-calendar",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "build:css": "tailwindcss -i ./style.css -o ./tailwind.css --minify",
    "prestart": "npm run build:css",
    "start": "electron .",
    "prebuild": "npm run build:css",
    "build": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "koffi": "^3.1.5"
  },
  "build": {
    "appId": "com.electroncalendar.desktop",
    "productName": "Desktop Calendar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist{,/**/*}"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
